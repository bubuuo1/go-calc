{
  "name": "go-calc",
  "version": "1.0.0",
  "description": "Shared household ledger with Supabase authentication and automation",
  "main": "next.config.js",
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:api": "echo \"Supabase mode: no local API server is required.\"",
    "prebuild": "npm test",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate:supabase": "node scripts/migrate-json-to-supabase.js"
  },
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "exceljs": "^4.4.0",
    "next": "16.3.3",
    "nodemailer": "9.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "resend": "^6.25.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/nodemailer": "8.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vitest": "3.2.7"
  }
}
